{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "STM32F407 CMSIS-DAP",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "serverpath": "D:/Workspace/DevEnv/openocd-v0.12.0-i686-w64-mingw32/bin/openocd.exe",
      "searchDir": [
        "D:/Workspace/DevEnv/openocd-v0.12.0-i686-w64-mingw32/share/openocd/scripts"
      ],
      "executable": "${command:cmake.launchTargetPath}",
      "preLaunchTask": "Build Firmware",
      "runToEntryPoint": "main",
      "openOCDLaunchCommands": [
        "transport select swd",
        "adapter speed 100",
        "init",
        "reset halt"
      ],
      "configFiles": [
        "openocd/interface-cmsis-dap-hid.cfg",
        "target/stm32f4x.cfg"
      ]
    }
  ]
}
