{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "STM32F407 (CMSIS-DAP, OpenOCD, Launch)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "servertype": "openocd",
      "serverpath": "E:/Workspace/DevEnv/openocd-v0.12.0-i686-w64-mingw32/bin/openocd.exe",
      "searchDir": [
        "E:/Workspace/DevEnv/openocd-v0.12.0-i686-w64-mingw32/share/openocd/scripts"
      ],
      "interface": "swd",
      "device": "STM32F407VE",
      "executable": "${command:cmake.launchTargetPath}",
      "runToEntryPoint": "main",
      "preLaunchTask": "Build Firmware",
      "configFiles": [
        "interface/cmsis-dap.cfg",
        "target/stm32f4x.cfg"
      ]
    },
    {
      "name": "STM32F407 (CMSIS-DAP, OpenOCD, Attach)",
      "type": "cortex-debug",
      "request": "attach",
      "cwd": "${workspaceFolder}",
      "servertype": "openocd",
      "serverpath": "E:/Workspace/DevEnv/openocd-v0.12.0-i686-w64-mingw32/bin/openocd.exe",
      "searchDir": [
        "E:/Workspace/DevEnv/openocd-v0.12.0-i686-w64-mingw32/share/openocd/scripts"
      ],
      "interface": "swd",
      "device": "STM32F407VE",
      "executable": "${command:cmake.launchTargetPath}",
      "configFiles": [
        "interface/cmsis-dap.cfg",
        "target/stm32f4x.cfg"
      ]
    }
  ]
}
